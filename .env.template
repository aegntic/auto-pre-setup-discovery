# ╔═══════════════════════════════════════════════════════════════════════════════════╗
# ║                                                                                   ║
# ║                            PROLOGUE ENVIRONMENT TEMPLATE                             ║
# ║                                                                                   ║
# ║  This template shows all available environment variables for Prologue.          ║
# ║  Copy this file to .env and fill in your actual values.                           ║
# ║                                                                                   ║
# ║  SECURITY NOTES:                                                                 ║
# ║  - Never commit .env file to version control                                      ║
# ║  - Use strong, unique API keys                                                   ║
# ║  - Rotate keys regularly                                                          ║
# ║  - Keep this template public - it contains no secrets                            ║
# ╚═══════════════════════════════════════════════════════════════════════════════════╝

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                           AI SERVICE CONFIGURATION                             │
# └─────────────────────────────────────────────────────────────────────────────┘

# Anthropic Claude API (Required for primary AI functionality)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI GPT API (Optional, for additional AI capabilities)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                       PROPRIETARY AI PROMPTS                                │
# └─────────────────────────────────────────────────────────────────────────────┘

# FPEF System Prompt (Proprietary - keep secure)
FPEF_SYSTEM_PROMPT=

# Agent-specific prompts (Optional - enhances each AI agent's capabilities)
PROLOGUE_AGENT_VISIONARY_PROMPT=
PROLOGUE_AGENT_BUILDER_PROMPT=
PROLOGUE_AGENT_DESIGNER_PROMPT=
PROLOGUE_AGENT_DATA_PROMPT=
PROLOGUE_AGENT_SECURITY_PROMPT=
PROLOGUE_AGENT_DEPLOYMENT_PROMPT=

# Proprietary response templates (Optional)
PROLOGUE_RESPONSE_ERROR=
PROLOGUE_RESPONSE_SUCCESS=
PROLOGUE_RESPONSE_WELCOME=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                       SECURITY & ENCRYPTION                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# Encryption key for secure configuration (Generate with: openssl rand -hex 32)
PROLOGUE_ENCRYPTION_KEY=your_32_character_hex_encryption_key_here

# JWT secret for authentication (Generate with: openssl rand -hex 32)
JWT_SECRET=your_32_character_hex_jwt_secret_here

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                         EMAIL SERVICES                                      │
# └─────────────────────────────────────────────────────────────────────────────┘

# Resend API for email registration
RESEND_API_KEY=re_your_resend_api_key_here

# Email configuration
FROM_EMAIL=noreply@logue.pro
FROM_NAME=Prologue Team
ADMIN_EMAIL=team@logue.pro

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                           DNS MANAGEMENT                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Porkbun API for DNS management (Optional - for automatic DNS configuration)
PORKBUN_API_KEY=pk_your_porkbun_api_key_here
PORKBUN_SECRET_KEY=sk_your_porkbun_secret_key_here

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                         DATABASE & STORAGE                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# Database URL (Optional - for persistent data storage)
DATABASE_URL=postgresql://user:password@localhost:5432/prologue

# Redis URL (Optional - for caching and sessions)
REDIS_URL=redis://localhost:6379

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                        DEVELOPMENT SETTINGS                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# Environment
NODE_ENV=development

# Server configuration
PORT=3001

# Logging
LOG_LEVEL=info

# CORS settings
CORS_ORIGIN=*

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                         PRODUCTION SETTINGS                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# Production overrides (Uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=warn
# CORS_ORIGIN=https://logue.pro

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                            OPTIONAL SERVICES                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# Google AI Platform (Optional)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# GitHub token (Optional - for repository operations)
GITHUB_TOKEN=ghp_your_github_token_here

# Cloudflare (Optional - for CDN and analytics)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                           USAGE INSTRUCTIONS                                │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# 1. Copy this template to .env:
#    cp .env.template .env
#
# 2. Fill in your actual values in .env
#
# 3. Secure your .env file:
#    chmod 600 .env
#
# 4. Add .env to .gitignore (already included)
#
# 5. For production, use environment variables or secret management
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                        SECURITY BEST PRACTICES                               │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# • Use different API keys for development and production
# • Rotate keys regularly (every 90 days recommended)
# • Monitor API usage and set up alerts
# • Use read-only API keys where possible
# • Never share or commit API keys
# • Use strong, unique secrets
# • Enable API key restrictions (IP ranges, domains, etc.)
# • Keep backup of encryption keys in secure location
# • Regularly audit environment variables
#
# ╔═══════════════════════════════════════════════════════════════════════════════════╗
# ║                       PROLOGUE CONFIGURATION COMPLETE                           ║
