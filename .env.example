# ===========================================
# Prologue Environment Configuration
# ===========================================

# Development Mode
NODE_ENV=development
PORT=3001

# ===========================================
# Email Service (Resend)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@logue.pro
FROM_NAME=Prologue Team
ADMIN_EMAIL=team@logue.pro

# ===========================================
# Development Settings
# ===========================================
LOG_LEVEL=info
CORS_ORIGIN=*

# ===========================================
# Early Access Configuration
# ===========================================
EARLY_ACCESS_ENABLED=true
MAX_REGISTRATIONS_PER_DAY=100
NOTIFICATION_ENABLED=true

# ===========================================
# Database (Optional - for production)
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/prologue
# REDIS_URL=redis://localhost:6379

# ===========================================
# Security
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_for_sessions
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10